# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local artifacts (measured outputs are committed deliberately under docs/measurements/)
*.rrd
*.ckpt
node_modules/
web/dist/

# Rerun viewer assets: fetched at image-build from the pinned npm tarball
# (hash in web/vendor/rerun/SHA256SUMS); only VERSION + SHA256SUMS live in git.
web/vendor/rerun/*
!web/vendor/rerun/VERSION
!web/vendor/rerun/SHA256SUMS

# Policy params baked into the probe image (fetched from the Volume; not in git)
probe/params/
